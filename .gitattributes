# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf
*.pyi text eol=lf

# Shell scripts
*.sh text eol=lf

# Markdown & documentation
*.md text eol=lf
*.txt text eol=lf

# TOML & YAML
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Data files (treat as binary)
*.csv binary
*.json binary
*.jsonl binary
*.parquet binary

# Archives
*.zip binary
*.tar binary
*.gz binary
